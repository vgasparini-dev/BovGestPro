-- ════════════════════════════════════════════════════════════════════
-- BoviGest PRO — schema: pesagens, vacinacoes, nascimentos, leite,
-- insumos, lotes, reproducao, pastos
-- Mesmo padrão de RLS por farm_id + Realtime já usado em
-- animais/financeiro/confinamento.
-- ════════════════════════════════════════════════════════════════════

-- ── pesagens ─────────────────────────────────────────────────────────
create table if not exists public.pesagens (
  id uuid primary key default gen_random_uuid(),
  farm_id uuid not null default public.get_my_farm_id(),
  brinco text not null default '',
  peso_atual numeric not null default 0,
  peso_anterior numeric,
  data_anterior text,
  data text,
  observacao text,
  created_at timestamptz not null default now()
);
alter table public.pesagens enable row level security;

create policy "pesagens select" on public.pesagens for select to authenticated using (farm_id = public.get_my_farm_id());
create policy "pesagens insert" on public.pesagens for insert to authenticated with check (farm_id = public.get_my_farm_id());
create policy "pesagens update" on public.pesagens for update to authenticated using (farm_id = public.get_my_farm_id()) with check (farm_id = public.get_my_farm_id());
create policy "pesagens delete" on public.pesagens for delete to authenticated using (farm_id = public.get_my_farm_id());

-- ── vacinacoes ───────────────────────────────────────────────────────
create table if not exists public.vacinacoes (
  id uuid primary key default gen_random_uuid(),
  farm_id uuid not null default public.get_my_farm_id(),
  vacina text not null default '',
  lote text not null default '',
  brincos text[] not null default '{}',
  data_aplicacao text,
  data_liberacao text,
  veterinario text,
  observacao text,
  created_at timestamptz not null default now()
);
alter table public.vacinacoes enable row level security;

create policy "vacinacoes select" on public.vacinacoes for select to authenticated using (farm_id = public.get_my_farm_id());
create policy "vacinacoes insert" on public.vacinacoes for insert to authenticated with check (farm_id = public.get_my_farm_id());
create policy "vacinacoes update" on public.vacinacoes for update to authenticated using (farm_id = public.get_my_farm_id()) with check (farm_id = public.get_my_farm_id());
create policy "vacinacoes delete" on public.vacinacoes for delete to authenticated using (farm_id = public.get_my_farm_id());

-- ── nascimentos ───────────────────────────────────────────────────────
create table if not exists public.nascimentos (
  id uuid primary key default gen_random_uuid(),
