-- ── Realtime nas 8 novas tabelas ──────────────────────────────────────
do $$
begin
  begin alter publication supabase_realtime drop table public.pesagens; exception when others then null; end;
  begin alter publication supabase_realtime drop table public.vacinacoes; exception when others then null; end;
  begin alter publication supabase_realtime drop table public.nascimentos; exception when others then null; end;
  begin alter publication supabase_realtime drop table public.leite; exception when others then null; end;
  begin alter publication supabase_realtime drop table public.insumos; exception when others then null; end;
  begin alter publication supabase_realtime drop table public.lotes; exception when others then null; end;
  begin alter publication supabase_realtime drop table public.reproducao; exception when others then null; end;
  begin alter publication supabase_realtime drop table public.pastos; exception when others then null; end;
  alter publication supabase_realtime add table public.pesagens;
  alter publication supabase_realtime add table public.vacinacoes;
  alter publication supabase_realtime add table public.nascimentos;
  alter publication supabase_realtime add table public.leite;
  alter publication supabase_realtime add table public.insumos;
  alter publication supabase_realtime add table public.lotes;
  alter publication supabase_realtime add table public.reproducao;
  alter publication supabase_realtime add table public.pastos;
end $$;